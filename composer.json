{
    "name": "maidemde/typovigil-agent",
    "type": "typo3-cms-extension",
    "description": "Reports the installed TYPO3 version and extensions to a TypoVigil hub, so update and security status can be tracked centrally.",
    "homepage": "https://maidem.de",
    "license": "GPL-2.0-or-later",
    "keywords": [
        "TYPO3 CMS",
        "security",
        "monitoring",
        "updates"
    ],
    "authors": [
        {
            "name": "Maik Demuth",
            "email": "hi@maidem.de",
            "homepage": "https://maidem.de"
        }
    ],
    "require": {
        "php": ">=8.1",
        "typo3/cms-backend": "^13.4 || ^14.0",
        "typo3/cms-core": "^13.4 || ^14.0",
        "typo3/cms-scheduler": "^13.4 || ^14.0"
    },
    "autoload": {
        "psr-4": {
            "Maidemde\\TypovigilAgent\\": "Classes/"
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "typovigil_agent"
        }
    }
}
